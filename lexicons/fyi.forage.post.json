{
  "lexicon": 1,
  "id": "fyi.forage.post",
  "defs": {
    "main": {
      "type": "record",
      "description": "A Forage post. Author-deleted = record deleted; edits are putRecord with editedAt.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "feed",
          "format",
          "title",
          "createdAt"
        ],
        "properties": {
          "feed": {
            "type": "string",
            "format": "at-uri",
            "description": "The fyi.forage.feed record this post belongs to"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "link"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 3000,
            "maxGraphemes": 300
          },
          "bodyMd": {
            "type": "string",
            "maxLength": 100000,
            "description": "Markdown body (text posts)"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Link target (link posts)"
          },
          "tagId": {
            "type": "string",
            "description": "Field-scoped tag id"
          },
          "nsfw": {
            "type": "boolean",
            "default": false
          },
          "spoiler": {
            "type": "boolean",
            "default": false
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Authoring time"
          },
          "editedAt": {
            "type": "string",
            "format": "datetime",
            "description": "Present iff the record was edited after creation"
          },
          "held": {
            "type": "boolean",
            "default": false,
            "description": "Automod verdict at write time: held for steward review; cleared by a mod approved action"
          }
        }
      }
    }
  }
}
