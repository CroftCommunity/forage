{
  "lexicon": 1,
  "id": "fyi.forage.save",
  "defs": {
    "main": {
      "type": "record",
      "description": "A saved item. Unsave = record deleted.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "The saved post or comment"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Save time"
          }
        }
      }
    }
  }
}
