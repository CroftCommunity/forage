{
  "lexicon": 1,
  "id": "fyi.forage.vote",
  "defs": {
    "main": {
      "type": "record",
      "description": "A boost or bury. Retraction = record deleted; re-vote = putRecord.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "subject",
          "value",
          "createdAt"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "at-uri",
            "description": "The post or comment voted on"
          },
          "value": {
            "type": "integer",
            "enum": [
              1,
              -1
            ],
            "description": "boost = 1, bury = -1"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Vote time"
          }
        }
      }
    }
  }
}
